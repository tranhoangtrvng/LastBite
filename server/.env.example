# Số phút người mua được đặt trước giờ bắt đầu nhận (mặc định 120 = 2 tiếng).
# Khi demo ban ngày muốn thấy món suốt cả ngày thì đặt 1440 (24 tiếng).
BOOKING_LEAD_MINUTES=120
